@page "/admin/login"
@layout AdminLayout
@inject IConfiguration Config
@inject AmariMusic.Services.TurnstileService Turnstile

<PageTitle>Admin Login | Amari Music</PageTitle>

<div class="row justify-content-center mt-5">
    <div class="col-md-4">
        <div class="card shadow-sm rounded-4">
            <div class="card-body p-5">
                <h1 class="fs-3 fw-bold text-center mb-4">
                    <i class="bi bi-shield-lock me-2"></i>Admin Login
                </h1>

                @if (_error)
                {
                    <div class="alert alert-danger" role="alert">
                        <i class="bi bi-exclamation-triangle me-2"></i>Invalid credentials.
                    </div>
                }

                @if (_captchaError)
                {
                    <div class="alert alert-danger" role="alert">
                        <i class="bi bi-exclamation-triangle me-2"></i>Please complete the verification challenge.
                    </div>
                }

                <form method="post" action="/admin/do-login">
                    <AntiforgeryToken />
                    <div class="mb-3">
                        <label for="username" class="form-label fw-semibold">Username</label>
                        <input id="username" name="username" type="text" class="form-control form-control-lg"
                               autocomplete="username" required />
                    </div>
                    <div class="mb-4">
                        <label for="password" class="form-label fw-semibold">Password</label>
                        <input id="password" name="password" type="password" class="form-control form-control-lg"
                               autocomplete="current-password" required />
                    </div>
                    @if (Turnstile.IsConfigured)
                    {
                        <div class="mb-4">
                            <div class="cf-turnstile" data-sitekey="@Config["Turnstile:SiteKey"]"></div>
                        </div>
                    }
                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg">Sign In</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    private bool _error { get; set; }

    [SupplyParameterFromQuery]
    private bool _captchaError { get; set; }
}
