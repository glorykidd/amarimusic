@page "/admin/contacts"
@layout AdminLayout
@attribute [Authorize]
@using AmariMusic.Data
@using AmariMusic.Models
@using Microsoft.EntityFrameworkCore
@inject ContactDbContext Db

<PageTitle>Inquiries | Admin</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="fs-2 fw-bold mb-0">Inquiries</h1>
    @if (_newCount > 0)
    {
        <span class="badge bg-warning text-dark fs-6">@_newCount new</span>
    }
</div>

@if (_submissions.Count == 0)
{
    <div class="alert alert-info rounded-4">No inquiries yet.</div>
}
else
{
    <div class="card shadow-sm rounded-4 border-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Date</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Message</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in _submissions)
                    {
                        <tr class="@(s.ViewedAt is null ? "table-warning" : "")">
                            <td class="text-nowrap">@s.SubmittedAt.ToLocalTime().ToString("MMM d, yyyy")</td>
                            <td class="fw-semibold">@s.Name</td>
                            <td>@s.Email</td>
                            <td>@(s.Phone ?? "—")</td>
                            <td>
                                <span class="d-inline-block text-truncate" style="max-width:220px;" title="@s.Message">
                                    @s.Message
                                </span>
                            </td>
                            <td>
                                @if (s.ViewedAt is null)
                                {
                                    <span class="badge bg-warning text-dark">New</span>
                                }
                                else if (s.RepliedAt is not null)
                                {
                                    <span class="badge bg-success">Replied</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Viewed</span>
                                }
                            </td>
                            <td><a href="/admin/contacts/@s.Id" class="btn btn-sm btn-outline-primary">View</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<ContactSubmission> _submissions = [];
    private int _newCount;

    protected override async Task OnInitializedAsync()
    {
        _submissions = await Db.ContactSubmissions
            .OrderByDescending(s => s.SubmittedAt)
            .ToListAsync();
        _newCount = _submissions.Count(s => s.ViewedAt is null);
    }
}
