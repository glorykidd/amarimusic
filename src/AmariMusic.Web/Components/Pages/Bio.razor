<section class="bio-stats-section" aria-label="Career highlights">
    <div class="container py-5">
        <div class="row g-4 text-center">
            <div class="col-6 col-md-3">
                <div class="stat-card p-4">
                    <div class="stat-number">50+</div>
                    <div class="stat-label">Years in Music</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-card p-4">
                    <div class="stat-number">600+</div>
                    <div class="stat-label">Songs Written</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-card p-4">
                    <div class="stat-number">7</div>
                    <div class="stat-label">Major Record Labels</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-card p-4">
                    <div class="stat-number">30+</div>
                    <div class="stat-label">Legendary Artists</div>
                </div>
            </div>
        </div>
    </div>
</section>
