@page "/"

<PageTitle>Turley Richards | Vocalist, Producer &amp; Vocal Coach | Louisville, KY</PageTitle>

<HeadContent>
    <meta name="description" content="Turley Richards is a vocalist, producer, vocal coach, and songwriter with 50+ years in the music industry. Book lessons or studio sessions in Louisville, KY." />
    <meta property="og:title" content="Turley Richards | Vocalist, Producer &amp; Vocal Coach" />
    <meta property="og:description" content="50+ years of music. Vocal coaching, songwriting, studio recording, and music therapy in Louisville, KY." />
    <meta property="og:image" content="/images/turley-homepage.jpg" />
    <meta property="og:type" content="website" />
    <link rel="canonical" href="/" />
</HeadContent>

<!-- Hero -->
<section class="hero-section" aria-label="Introduction">
    <div class="container py-5">
        <div class="row align-items-center g-4">
            <div class="col-md-7">
                <h1 class="hero-title">Welcome to Turley's Place</h1>
                <p class="hero-lead">
                    I'm <strong>Turley Richards</strong> — vocalist, producer, vocal coach, and songwriter.
                    With over 50 years in the music industry and 600+ songs written, I bring a lifetime of
                    professional experience to every lesson, session, and performance.
                </p>
                <div class="d-flex flex-wrap gap-3 mt-4">
                    <a href="/bio" class="btn btn-primary btn-lg">
                        <i class="bi bi-person-circle me-2"></i>Read My Bio
                    </a>
                    <a href="/contact" class="btn btn-outline-light btn-lg">
                        <i class="bi bi-envelope me-2"></i>Contact Turley
                    </a>
                </div>
            </div>
            <div class="col-md-5 text-center">
                <img src="/images/turley-homepage.jpg"
                     alt="Turley Richards, professional vocalist and vocal coach"
                     class="hero-img img-fluid" />
            </div>
        </div>
    </div>
</section>

<!-- Services -->
<section class="services-section" aria-labelledby="services-heading">
    <div class="container py-5">
        <h2 id="services-heading" class="section-heading text-center mb-5">What I Offer</h2>
        <div class="row g-4">
            <div class="col-md-4 d-flex">
                <div class="service-card text-center p-4 w-100 d-flex flex-column">
                    <img src="/images/musicnotes.png" alt="" aria-hidden="true" class="service-icon mb-3 mx-auto" />
                    <h3 class="service-title">Vocal Coaching &amp; Lessons</h3>
                    <p class="flex-grow-1">Personalized singing instruction drawing on techniques learned in New York, Los Angeles, and Nashville studios. All skill levels welcome.</p>
                    <a href="/contact" class="btn btn-sm btn-outline-primary mt-3">
                        <i class="bi bi-music-note-list me-1"></i>Learn More
                    </a>
                </div>
            </div>
            <div class="col-md-4 d-flex">
                <div class="service-card text-center p-4 w-100 d-flex flex-column">
                    <img src="/images/headphones.png" alt="" aria-hidden="true" class="service-icon mb-3 mx-auto" />
                    <h3 class="service-title">Songwriting Instruction</h3>
                    <p class="flex-grow-1">Learn the craft from someone who has written and published over 600 songs across five decades in the industry.</p>
                    <a href="/contact" class="btn btn-sm btn-outline-primary mt-3">
                        <i class="bi bi-music-note-list me-1"></i>Learn More
                    </a>
                </div>
            </div>
            <div class="col-md-4 d-flex">
                <div class="service-card text-center p-4 w-100 d-flex flex-column">
                    <img src="/images/cdtrack.png" alt="" aria-hidden="true" class="service-icon mb-3 mx-auto" />
                    <h3 class="service-title">Studio Recording</h3>
                    <p class="flex-grow-1">Record in a professional 12-track studio with expert guidance on technique, production, and the music business — 40+ years of industry experience at your disposal.</p>
                    <a href="/contact" class="btn btn-sm btn-outline-primary mt-3">
                        <i class="bi bi-music-note-list me-1"></i>Learn More
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Music Therapy -->
<section class="therapy-section" aria-labelledby="therapy-heading">
    <div class="container py-5">
        <div class="row align-items-center g-4">
            <div class="col-md-6">
                <h2 id="therapy-heading" class="section-heading">Music Therapy</h2>
                <p class="fs-5">
                    Music has the power to heal. I offer music therapy sessions that use the transformative
                    nature of music to support emotional well-being, connection, and personal growth.
                    Having overcome personal adversity through music myself, I understand its profound impact.
                </p>
                <a href="/contact" class="btn btn-primary">
                    <i class="bi bi-mailbox me-2"></i>Get In Touch
                </a>
            </div>
            <div class="col-md-6 text-center">
                <img src="/images/turleyonstage.jpg"
                     alt="Turley Richards performing on stage"
                     class="img-fluid rounded-4 shadow" />
            </div>
        </div>
    </div>
</section>

<!-- Album -->
<section class="album-section" aria-labelledby="album-heading">
    <div class="container py-5">
        <div class="row align-items-center g-4">
            <div class="col-md-5 text-center">
                <img src="/images/turleyalbum.jpg"
                     alt="The Man In Me album cover by Turley Richards"
                     class="img-fluid rounded-4 shadow album-cover" />
            </div>
            <div class="col-md-7">
                <h2 id="album-heading" class="section-heading">The Man In Me</h2>
                <p class="fs-5">
                    A compilation album spanning 1970–2020, showcasing five decades of Turley's artistic journey.
                    Signed by seven major record labels — Warner Brothers, Columbia, Atlantic, Epic, MGM,
                    and 20th Century Fox — this collection captures a career that has touched millions.
                </p>
                <img src="/images/turleyrichards2.png"
                     alt="Turley Richards"
                     class="img-fluid rounded-4 mt-3 shadow" style="max-width: 300px;" />
            </div>
        </div>
    </div>
</section>

<!-- Performed With -->
<section class="performers-section" aria-labelledby="performers-heading">
    <div class="container py-5">
        <h2 id="performers-heading" class="section-heading text-center mb-4">Performed With the Legends</h2>
        <p class="text-center lead mb-4">Over 50 years on stage alongside some of the greatest names in music:</p>
        <p class="performers-list text-center">
            Aretha Franklin &bull; Miles Davis &bull; Tony Bennett &bull; The 5th Dimension &bull;
            Billy Preston &bull; BJ Thomas &bull; Eddie Harris &bull; Les McCann &bull;
            Bobby Vinton &bull; Paul Revere &bull; The Raiders &bull; The Turtles &bull;
            Sonny &amp; Cher &bull; Bobby Rydell &bull; Ronettes &bull; The Vogues &bull;
            Lovin' Spoonful &bull; Youngbloods &bull; Charlie Rich &bull; Roger Miller &bull;
            Tommy Roe &bull; Hank Williams Jr. &bull; Fats Domino &bull; Temptations &bull;
            Lou Rawls &bull; Ink Spots &bull; Righteous Brothers &bull; Brooklyn Bridge &bull;
            Paul Anka &bull; Bobby Darin &bull; and many more
        </p>
    </div>
</section>

<!-- TV Appearances -->
<section class="tv-section" aria-labelledby="tv-heading">
    <div class="container py-5">
        <h2 id="tv-heading" class="section-heading text-center mb-4">National Television</h2>
        <div class="row justify-content-center">
            <div class="col-md-8 text-center">
                <p class="fs-5 mb-4">Turley has appeared on some of the most iconic television programs in American history:</p>
                <ul class="list-unstyled tv-list fs-5">
                    <li><i class="bi bi-tv me-2"></i>Dick Clark's American Bandstand</li>
                    <li><i class="bi bi-tv me-2"></i>The Tonight Show</li>
                    <li><i class="bi bi-tv me-2"></i>The Merv Griffin Show</li>
                    <li><i class="bi bi-tv me-2"></i>The David Frost Show</li>
                </ul>
            </div>
        </div>
    </div>
</section>

<!-- CTA -->
<section class="cta-section" aria-labelledby="contact-heading">
    <div class="container py-5 text-center">
        <h2 id="contact-heading" class="section-heading mb-3">Want To Learn More?</h2>
        <p class="fs-4 mb-4">
            <i class="bi bi-music-note-list me-2"></i>
            Ready to start your musical journey? Reach out today.
            <i class="bi bi-music-note-list ms-2"></i>
        </p>
        <div class="d-flex flex-wrap justify-content-center gap-3">
            <a href="/contact" class="btn btn-light btn-lg">
                <i class="bi bi-envelope me-2"></i>Send a Message
            </a>
        </div>
    </div>
</section>
