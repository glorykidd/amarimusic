@page "/contact"
@attribute [EnableRateLimiting("contact")]
@using System.ComponentModel.DataAnnotations
@using AmariMusic.Data
@using AmariMusic.Models
@using AmariMusic.Services
@using Microsoft.AspNetCore.RateLimiting
@inject ContactDbContext Db
@inject EmailService Email
@inject ILogger<Contact> Logger
@inject TurnstileService Turnstile
@inject IHttpContextAccessor HttpContextAccessor
@inject IConfiguration Config

<PageTitle>Contact | Turley Richards</PageTitle>

<HeadContent>
    <meta name="description" content="Get in touch with Turley Richards for vocal coaching, songwriting lessons, studio recording, or music therapy in Louisville, KY." />
    <link rel="canonical" href="/contact" />
</HeadContent>

<section class="contact-section">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <h1 class="section-heading text-center mb-2">Get In Touch</h1>
                <p class="text-center text-muted mb-5">
                    Ready to start your musical journey? Send a message and Turley will get back to you.
                </p>

                @if (_submitted)
                {
                    <div class="alert alert-success rounded-4 text-center fs-5" role="alert">
                        <i class="bi bi-check-circle me-2"></i>
                        Thank you, <strong>@_submittedName</strong>! Your message has been received. Turley will be in touch soon.
                    </div>
                }
                else
                {
                    @if (_submitError)
                    {
                        <div class="alert alert-danger rounded-4" role="alert">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            Something went wrong. Please try again or reach out directly at
                            <a href="mailto:turley@turleyrichards.com">turley@turleyrichards.com</a>.
                        </div>
                    }

                    <div class="contact-card p-4 p-md-5 rounded-4 shadow-sm">
                        <EditForm Model="Input" OnValidSubmit="HandleSubmit" FormName="contact" Enhance="true">
                            <DataAnnotationsValidator />

                            <div class="mb-4">
                                <label for="name" class="form-label fw-semibold">Full Name <span class="text-danger">*</span></label>
                                <InputText id="name" @bind-Value="Input.Name" class="form-control form-control-lg" placeholder="Your name" />
                                <ValidationMessage For="() => Input.Name" class="text-danger small mt-1" />
                            </div>

                            <div class="mb-4">
                                <label for="email" class="form-label fw-semibold">Email Address <span class="text-danger">*</span></label>
                                <InputText id="email" @bind-Value="Input.Email" class="form-control form-control-lg" placeholder="you@example.com" type="email" />
                                <ValidationMessage For="() => Input.Email" class="text-danger small mt-1" />
                            </div>

                            <div class="mb-4">
                                <label for="phone" class="form-label fw-semibold">Phone <span class="text-muted fw-normal">(optional)</span></label>
                                <InputText id="phone" @bind-Value="Input.Phone" class="form-control form-control-lg" placeholder="(555) 000-0000" />
                                <ValidationMessage For="() => Input.Phone" class="text-danger small mt-1" />
                            </div>

                            <div class="mb-4">
                                <label for="message" class="form-label fw-semibold">Message <span class="text-danger">*</span></label>
                                <InputTextArea id="message" @bind-Value="Input.Message" class="form-control form-control-lg" rows="5"
                                               placeholder="Tell Turley what you're looking for — lessons, studio time, a performance booking, etc." />
                                <ValidationMessage For="() => Input.Message" class="text-danger small mt-1" />
                            </div>

                            @if (Turnstile.IsConfigured)
                            {
                                <div class="mb-4">
                                    <div class="cf-turnstile" data-sitekey="@Config["Turnstile:SiteKey"]"></div>
                                    @if (_captchaError)
                                    {
                                        <div class="text-danger small mt-1">Please complete the verification challenge.</div>
                                    }
                                </div>
                            }

                            <div class="d-grid">
                                <button type="submit" class="btn btn-primary btn-lg">
                                    <i class="bi bi-send me-2"></i>Send Message
                                </button>
                            </div>
                        </EditForm>
                    </div>
                }
            </div>

            <!-- Sidebar contact info -->
            <div class="col-lg-4 mt-5 mt-lg-0">
                <div class="contact-info-card p-4 rounded-4 h-100">
                    <h2 class="fs-4 fw-bold mb-4">Direct Contact</h2>
                    <ul class="list-unstyled contact-info-list">
                        <li>
                            <i class="bi bi-telephone-fill"></i>
                            <a href="tel:+15024529011">(502) 452-9011</a>
                        </li>
                        <li>
                            <i class="bi bi-envelope-fill"></i>
                            <a href="mailto:turley@turleyrichards.com">turley@turleyrichards.com</a>
                        </li>
                        <li>
                            <i class="bi bi-facebook"></i>
                            <a href="https://www.facebook.com/turleyrichards" target="_blank" rel="noopener">facebook.com/turleyrichards</a>
                        </li>
                    </ul>

                    <hr class="my-4" />

                    <h3 class="fs-5 fw-bold mb-3">Services Available</h3>
                    <ul class="services-checklist list-unstyled">
                        <li><i class="bi bi-check-circle-fill text-success me-2"></i>Vocal Coaching &amp; Lessons</li>
                        <li><i class="bi bi-check-circle-fill text-success me-2"></i>Songwriting Instruction</li>
                        <li><i class="bi bi-check-circle-fill text-success me-2"></i>Studio Recording</li>
                        <li><i class="bi bi-check-circle-fill text-success me-2"></i>Music Therapy</li>
                        <li><i class="bi bi-check-circle-fill text-success me-2"></i>Music Business Consulting</li>
                        <li><i class="bi bi-check-circle-fill text-success me-2"></i>Performance Bookings</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    [SupplyParameterFromForm(FormName = "contact")]
    private ContactFormModel Input { get; set; } = new();

    private bool _submitted;
    private bool _submitError;
    private bool _captchaError;
    private string _submittedName = string.Empty;

    private async Task HandleSubmit()
    {
        if (Turnstile.IsConfigured)
        {
            var httpContext = HttpContextAccessor.HttpContext;
            var token = httpContext?.Request.Form["cf-turnstile-response"].ToString();
            var remoteIp = httpContext?.Connection.RemoteIpAddress?.ToString();

            if (!await Turnstile.VerifyAsync(token, remoteIp))
            {
                _captchaError = true;
                return;
            }
        }

        try
        {
            var submission = new ContactSubmission
            {
                Name = Input.Name,
                Email = Input.Email,
                Phone = string.IsNullOrWhiteSpace(Input.Phone) ? null : Input.Phone,
                Message = Input.Message,
                SubmittedAt = DateTime.UtcNow
            };

            Db.ContactSubmissions.Add(submission);
            await Db.SaveChangesAsync();

            await Email.SendAdminNotificationAsync(submission);

            _submittedName = Input.Name;
            _submitted = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save contact submission");
            _submitError = true;
        }
    }

    private class ContactFormModel
    {
        [Required(ErrorMessage = "Name is required.", AllowEmptyStrings = false)]
        [StringLength(100, MinimumLength = 1)]
        public string Name { get; set; } = string.Empty;

        [Required(ErrorMessage = "Email is required.", AllowEmptyStrings = false)]
        [EmailAddress(ErrorMessage = "Please enter a valid email address.")]
        [StringLength(200, MinimumLength = 1)]
        public string Email { get; set; } = string.Empty;

        [Phone(ErrorMessage = "Please enter a valid phone number.")]
        [StringLength(30)]
        public string? Phone
        {
            get => _phone;
            set => _phone = string.IsNullOrWhiteSpace(value) ? null : value;
        }
        private string? _phone;

        [Required(ErrorMessage = "Message is required.", AllowEmptyStrings = false)]
        [StringLength(2000, MinimumLength = 1, ErrorMessage = "Message must be under 2000 characters.")]
        public string Message { get; set; } = string.Empty;
    }
}
